# Copy to .env.local.

# The app's PIN: 6 digits, not 000000 (the tests' wrong PIN). Restart Metro with --clear after changing it.
EXPO_PUBLIC_PIN=

# Optional: the simulator and emulator to test on (default: any booted one), and Metro's port (default: 8081).
# IOS_DEVICE=iPhone 17
# ANDROID_DEVICE=Pixel 9 Pro
# METRO_PORT=8081
