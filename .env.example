# Copy to .env.local.

# The app's PIN: any 6 digits except 000000, which the tests type as the wrong PIN.
# Metro bakes EXPO_PUBLIC_ variables into the bundle, so restart it with --clear after a change.
EXPO_PUBLIC_PIN=

# Optional: the simulator and emulator to test on (default: any booted one), and Metro's port (default: 8081).
# IOS_DEVICE=iPhone 17
# ANDROID_DEVICE=Pixel 9 Pro
# METRO_PORT=8081
